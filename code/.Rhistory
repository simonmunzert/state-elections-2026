geom_text(aes(
label = ifelse(freq >= 0.05, scales::percent(freq, accuracy = 1, suffix = ""), ""),  # Only show label if percentage >= 10%
), position = position_fill(vjust = 0.5), size = 3.5, fontface = "bold", family = "Fira Sans", color = "white") +
